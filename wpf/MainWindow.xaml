<Window x:Class="LuckyPickerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YBH幸运摇人器" Height="760" Width="960"
        WindowStartupLocation="CenterScreen" Background="#F0F7FF"
        FontFamily="Microsoft YaHei">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="YBH幸运摇人器" FontSize="28" FontWeight="Bold"
                           Foreground="#2563EB" />
                <TextBlock x:Name="SubText" Text="智能抽人 · 不重复 · 屏蔽 · 连抽 · 语音播报 · 26H2 Build 13"
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Border Background="#EEF2FA" CornerRadius="12" Padding="14,6" Margin="0,0,10,0">
                    <TextBlock x:Name="ClassBadgeText" Text="● 当前班级：-" FontSize="12"
                               Foreground="#2C5282" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="SettingsBtn" Content="设置 ▾" Padding="14,6">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="名单管理 · 导入" Click="OnMenuEditor" />
                            <MenuItem Header="抽选记录" Click="OnMenuHistory" />
                            <MenuItem Header="版本 · 更新" Click="OnMenuAbout" />
                            <Separator />
                            <MenuItem x:Name="MenuAutoStart" Header="开机自启动" IsCheckable="True" Click="OnMenuAutoStart" />
                            <MenuItem x:Name="MenuBall" Header="桌面悬浮球" IsCheckable="True" Click="OnMenuBall" />
                            <Separator />
                            <MenuItem Header="退出程序" Click="OnMenuQuit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 筛选卡片 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="筛选" FontWeight="Bold" FontSize="14" Foreground="#3B5A8C" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <TextBlock Text="班级" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                            <ComboBox x:Name="ClassCombo" MinWidth="160" SelectionChanged="OnClassChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="性别" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                            <ToggleButton x:Name="GenderAll" Content="都抽" IsChecked="True" Click="OnGenderClick" Margin="0,0,6,0" />
                            <ToggleButton x:Name="GenderMale" Content="男生" Click="OnGenderClick" Margin="0,0,6,0" />
                            <ToggleButton x:Name="GenderFemale" Content="女生" Click="OnGenderClick" />
                        </StackPanel>
                        <CheckBox x:Name="NoRepeatBox" Content="不重复模式" IsChecked="True" FontSize="13"
                                  VerticalAlignment="Center" Margin="26,0,0,0" Checked="OnNoRepeatToggled" Unchecked="OnNoRepeatToggled" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 动作按钮 -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PickBtn" Grid.Column="0" Content="抽一人" Background="#1E3A8A"
                        Style="{StaticResource BigActionBtn}" Margin="0,0,7,0" Click="OnPick" />
                <Button x:Name="MultiBtn" Grid.Column="1" Content="连抽五人" Background="#2D3E6E"
                        Style="{StaticResource BigActionBtn}" Margin="7,0,0,0" Click="OnMulti" />
            </Grid>

            <!-- 结果区 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="14" Padding="20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#ECFDF5" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="VoiceStatusText" Text="♪ 语音：准备中" FontSize="11" Foreground="#065F46" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="PoolStatsText" Text="" FontSize="12" VerticalAlignment="Center"
                                       Foreground="#64748B" Margin="0,0,10,0" />
                            <Button x:Name="ResetBtn" Content="重置不重复池" Click="OnReset" Padding="12,4"
                                    Background="#4B5563" Foreground="White" FontSize="12" Cursor="Hand"
                                    BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PickedName" Text="——" FontSize="52" FontWeight="Bold"
                                   Foreground="#1F2B4E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <WrapPanel x:Name="MultiPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="HintText" Grid.Row="2" Text="点击「抽一人」开始抽取"
                               FontSize="12.5" Foreground="#64748B" />
                </Grid>
            </Border>

            <!-- 屏蔽区 -->
            <Border Grid.Row="3" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                    CornerRadius="14" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="屏蔽名单（被屏蔽的学生不参与抽取）" FontWeight="Bold" FontSize="12.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="BlockInput" Width="260" Height="32" VerticalContentAlignment="Center"
                                 KeyDown="OnBlockKeyDown" />
                        <Button x:Name="AddBlockBtn" Content="屏蔽此人" Click="OnAddBlock" Padding="14,6"
                                Margin="8,0,0,0" Cursor="Hand" />
                    </StackPanel>
                    <WrapPanel x:Name="BlockChips" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部 -->
        <TextBlock Grid.Row="3" Text="YBH幸运摇人器 · 单实例运行 · 托盘常驻 · 更新自动提醒"
                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
    </Grid>
</Window>
