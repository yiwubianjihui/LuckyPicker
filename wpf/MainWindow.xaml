<Window x:Class="LuckyPickerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YBH幸运摇人器" Height="660" Width="840"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnWindowKeyDown"
        FontFamily="Microsoft YaHei">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEF4FF" Offset="0" />
            <GradientStop Color="#F8FAFF" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- 主按钮渐变 -->
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="0.55" />
            <GradientStop Color="#1D4ED8" Offset="1" />
        </LinearGradientBrush>
        <!-- 大动作按钮 -->
        <Style x:Key="BigBtn" TargetType="Button">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentGrad}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="29">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 性别 pill（选中 = 品牌蓝） -->
        <Style x:Key="GenderPill" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#DCE4F2" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F0FE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGrad}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 轻量按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#DCE4F2" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#1E3A8A" />
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="YBH幸运摇人器" FontSize="27" FontWeight="Bold"
                           Foreground="#1E40AF" />
                <TextBlock x:Name="SubText" Text="班级随机摇人 · 26H2 Build 14"
                           FontSize="11.5" Foreground="#7C8DB5" Margin="2,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" CornerRadius="13" Padding="14,7"
                        BorderBrush="#DCE4F2" BorderThickness="1" Margin="0,0,10,0">
                    <TextBlock x:Name="ClassBadgeText" Text="● 当前班级：-" FontSize="12"
                               Foreground="#2C5282" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="SettingsBtn" Content="设置" Style="{StaticResource GhostBtn}"
                        Padding="18,7" Click="OnSettingsClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="语音设置" Click="OnMenuVoice" />
                            <MenuItem Header="名单管理 · 导入" Click="OnMenuEditor" />
                            <MenuItem Header="抽选记录" Click="OnMenuHistory" />
                            <MenuItem Header="版本 · 更新" Click="OnMenuAbout" />
                            <Separator />
                            <MenuItem x:Name="MenuAutoStart" Header="开机自启动" IsCheckable="True" Click="OnMenuAutoStart" />
                            <MenuItem x:Name="MenuBall" Header="桌面悬浮球" IsCheckable="True" Click="OnMenuBall" />
                            <MenuItem Header="悬浮球大小">
                                <MenuItem x:Name="MenuBallS" Header="小（80）" Tag="80" IsCheckable="True" Click="OnBallSizeClick" />
                                <MenuItem x:Name="MenuBallM" Header="中（96）" Tag="96" IsCheckable="True" Click="OnBallSizeClick" />
                                <MenuItem x:Name="MenuBallL" Header="大（120）" Tag="120" IsCheckable="True" Click="OnBallSizeClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="退出程序" Click="OnMenuQuit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 筛选行（班级 + 性别） ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,18,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                <TextBlock Text="班级" FontSize="13.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="ClassCombo" MinWidth="170" Height="34" VerticalContentAlignment="Center"
                          FontSize="13" SelectionChanged="OnClassChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="性别" FontSize="13.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ToggleButton x:Name="GenderAll" Content="都抽" IsChecked="True" Style="{StaticResource GenderPill}" Click="OnGenderClick" Margin="0,0,8,0" />
                <ToggleButton x:Name="GenderMale" Content="男生" Style="{StaticResource GenderPill}" Click="OnGenderClick" Margin="0,0,8,0" />
                <ToggleButton x:Name="GenderFemale" Content="女生" Style="{StaticResource GenderPill}" Click="OnGenderClick" />
            </StackPanel>
        </StackPanel>

        <!-- ===== 动作按钮 ===== -->
        <Grid Grid.Row="2" Margin="2,18,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PickBtn" Grid.Column="0" Content="抽一人"
                    Style="{StaticResource BigBtn}" Margin="0,0,8,0" Click="OnPick"
                    Effect="{StaticResource CardShadow}" />
            <Button x:Name="MultiBtn" Grid.Column="1" Content="连抽五人"
                    Style="{StaticResource BigBtn}" Margin="8,0,0,0" Click="OnMulti"
                    Effect="{StaticResource CardShadow}" />
        </Grid>

        <!-- ===== 结果区 ===== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E3EAF6" BorderThickness="1"
                CornerRadius="18" Margin="2,18,2,0" Padding="22,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#ECFDF5" CornerRadius="11" Padding="12,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="VoiceStatusText" Text="♪ 语音：准备中" FontSize="11" Foreground="#067A5B" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="PoolStatsText" Text="" FontSize="12" VerticalAlignment="Center"
                                   Foreground="#8A97B0" Margin="0,0,12,0" />
                        <Button x:Name="ResetBtn" Content="重置" Style="{StaticResource GhostBtn}"
                                Padding="14,4" Click="OnReset" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PickedName" Text="——" FontSize="54" FontWeight="Bold"
                               Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <WrapPanel x:Name="MultiPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="HintText" Grid.Row="2" Text="点击「抽一人」开始抽取"
                           FontSize="12.5" Foreground="#94A3B8" />
            </Grid>
        </Border>

        <!-- ===== 屏蔽区 ===== -->
        <Border Grid.Row="4" Background="#FFFAF2" BorderBrush="#FDE8C8" BorderThickness="1"
                CornerRadius="14" Margin="2,14,2,0" Padding="18,10">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="AddBlockBtn" DockPanel.Dock="Right" Content="屏蔽" Style="{StaticResource GhostBtn}"
                            Padding="16,5" Margin="8,0,0,0" Click="OnAddBlock" />
                    <TextBox x:Name="BlockInput" Height="30" VerticalContentAlignment="Center"
                             FontSize="12.5" KeyDown="OnBlockKeyDown" />
                </DockPanel>
                <WrapPanel x:Name="BlockChips" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
